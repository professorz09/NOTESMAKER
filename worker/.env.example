# Same Supabase project the app itself uses.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Dashboard → Project Settings → API → service_role key (NOT the anon key —
# this bypasses Row Level Security so the worker can read/write every
# user's queue and notes, not just one user's).
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Must match exactly what you set as the
# gemini-proxy edge function's own WORKER_SHARED_SECRET secret (see
# README.md) — generate one with: openssl rand -hex 32
WORKER_SHARED_SECRET=

# Render sets this automatically at deploy time — only needed for local
# testing.
PORT=3000
