# Gemini API Key (Required for AI generation features in AI Studio)
GEMINI_API_KEY=

# Supabase Configuration (Optional - app falls back to local storage if unset)
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=

# Optional long-running AI proxy (the worker server on Render/Railway), tried
# before the Supabase function; falls back to Supabase automatically when
# unset, asleep or unreachable. Comma-separated base URLs, no path:
# VITE_AI_PROXY_URL=https://notesmaker-batch-worker.onrender.com

# Vertex AI Backend (Configured in Supabase Secrets for gemini-proxy)
# GCP_SA_KEY=   <- paste the WHOLE service-account .json file here, as one value
# GCP_PROJECT_ID=   (optional — read from the JSON's project_id)
# GCP_REGION=